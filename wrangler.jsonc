{
  // Cloudflare Worker: serves the static PWA in web/ and the profile-sync API (src/worker.js).
  "name": "mi-diario",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "PROFILES", "id": "84922554d2ce4fd8abd94c851851ede9" }]
}
